# Copy to .env.local. Next.js and the ingestion/migration scripts load this file.
# Never commit actual credentials. The local demo works with empty values.
APP_ORIGIN=http://localhost:3000

# Development permits demo operator access by default. Set false for public use.
# A deployed hackathon showcase can explicitly enable it, visibly as a demo.
ALLOW_DEMO_OPERATOR=true
# For password login/public deployment, generate a secret of at least 32 chars:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
OPERATOR_PASSWORD=
# Set true at an HTTPS reverse proxy. Never enable on local plain HTTP.
COOKIE_SECURE=false
# Enable only if a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Empty means local JSON reports and imported network under .runtime/.
# Set a persistent absolute path for a single-host installation if preferred.
GERAK_DATA_DIR=
# Optional: enables PostgreSQL/PostGIS for civic reports. Run npm run db:migrate.
# DATABASE_URL=postgres://gerak:REPLACE_ME@localhost:5432/gerak
DATABASE_URL=

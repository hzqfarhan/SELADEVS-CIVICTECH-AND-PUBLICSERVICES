# Railway Worker Configuration
# Port assigned dynamically by Railway (defaults to 8080)
PORT=8080

# Optional PostgreSQL Connection String
# On Railway: Add a PostgreSQL database and set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Katsana Shuttle Telematics WebSocket Endpoint
KATSANA_WS_URL=wss://ws.shuttle.katsana.com/stream/1

# Logging
VERBOSE=false
